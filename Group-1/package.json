{
  "name": "shard-4-blackout-protocol",
  "version": "1.0.0",
  "type": "module",
  "description": "4-player real-time co-op tactical shooter and mystery game",
  "main": "server/src/index.ts",
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:client": "vite client --host 0.0.0.0 --port 5173",
    "build": "tsc --noEmit && vite build client",
    "start": "node dist/server/index.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.1",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}
